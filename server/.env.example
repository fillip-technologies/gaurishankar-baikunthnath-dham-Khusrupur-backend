# --- Server ---
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017

# --- Auth / JWT ---
SALT_ROUND=10
ACCESS_TOKEN_SECRET=change_me
REFRESH_TOKEN_SECRET=change_me
CHALLENGE_TOKEN_SECRET=change_me
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
CHALLENGE_TOKEN_EXPIRES_IN=5m

# --- Security thresholds (optional; sane defaults applied if unset) ---
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_OTP_MAX=10
RATE_LIMIT_WINDOW_MINUTES=15
MAX_OTP_ATTEMPTS=5

# --- Mail (SMTP) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
